{
  "name": "mitt-forsta-projekt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host",
    "dev:server": "node --watch --env-file=.env server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}

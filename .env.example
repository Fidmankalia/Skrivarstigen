ANTHROPIC_API_KEY=sk-ant-api03-din-nyckel-har

# Valfritt - hårt dagligt tak för antal AI-anrop över hela appen (standard: 200)
DAILY_REQUEST_LIMIT=100

# Valfritt - max AI-anrop per person/IP och timme (standard: 30)
PER_IP_HOURLY_LIMIT=30

# Valfritt - AI-röst för uppläsning via Azure Speech (utan nyckel visas
# knappen ändå, men faller alltid tillbaka på webbläsarens egen röst)
AZURE_SPEECH_KEY=din-nyckel-har
AZURE_SPEECH_REGION=swedencentral

# Valfritt - hårt tak för antal tecken/månad mot Azure (standard: 450000,
# gratisnivån är 500 000/månad - lämna marginal)
AZURE_MONTHLY_CHAR_LIMIT=450000

# Valfritt - max uppläsningar per person/IP och timme (standard: 20)
PER_IP_SPEECH_HOURLY_LIMIT=20
